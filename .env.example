# ── Model provider ────────────────────────────────────────────────
# google (default, free tier) | openai | anthropic
LLM_PROVIDER=google

# Gemini key: https://aistudio.google.com/apikey  (free tier works; check your limits in AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=

# Only needed if you switch LLM_PROVIDER
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model ids for the chosen provider. Check AI Studio for the current free-tier ids.
# MAIN = chat + tool use, SMALL = claim extraction + eval judge
MAIN_MODEL=gemini-flash-latest
SMALL_MODEL=gemini-flash-lite-latest

# Thinking effort of the MAIN model (Google provider only; other providers ignore it).
# default | minimal | low | medium | high | an integer token budget (Gemini 2.5 models take a budget, not a level).
# MAIN_THINKING applies to the steps that call tools (the first step and forced searches); low keeps verify turns fast.
# MAIN_THINKING_ANSWER applies to the later step that writes the answer; "default" = the provider's own choice.
MAIN_THINKING=low
MAIN_THINKING_ANSWER=default

# ── Web search (at least one required; Exa is primary, Tavily is fallback) ──
# https://dashboard.exa.ai
EXA_API_KEY=
# https://app.tavily.com
TAVILY_API_KEY=

# ── App ───────────────────────────────────────────────────────────
PORT=8787
DB_PATH=./data/agent.db
# Max model steps per turn (each step = one model call)
MAX_STEPS=4

# ── Dev / eval only ───────────────────────────────────────────────
# Freeze "now" (ISO with offset), e.g. 2026-11-12T11:00:00+05:30. Leave empty for real time.
NOW=
# Cache LLM responses on disk to save free-tier quota while developing (1 = on)
DEV_LLM_CACHE=0
