# ── Model provider ────────────────────────────────────────────────
# google (default, free tier) | openai | anthropic
LLM_PROVIDER=google

# Gemini key: https://aistudio.google.com/apikey  (free tier works; check your limits in AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=

# Only needed if you switch LLM_PROVIDER
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model ids for the chosen provider. MAIN = chat + tool use, SMALL = claim extraction + eval judge.
# Defaults are the Flash-Lite family: Gemini Flash needs a billed key. Free-tier limits as of 2026-11-11:
#   Flash       5 requests/min and   20 requests/day
#   Flash-Lite 15 requests/min and  500 requests/day
# A verify turn uses about 3-4 model requests and roughly 6-12 search requests (see README), so Flash's 20/day is ~5 verify turns.
# To use Flash, set MAIN_MODEL=gemini-flash-latest (and expect 429s without billing).
MAIN_MODEL=gemini-flash-lite-latest
SMALL_MODEL=gemini-flash-lite-latest

# Thinking effort of the MAIN model (Google provider only; other providers ignore it).
# default | minimal | low | medium | high | an integer token budget (Gemini 2.5 models take a budget, not a level).
# MAIN_THINKING applies to the steps that call tools (the first step and forced searches); low keeps verify turns fast.
# MAIN_THINKING_ANSWER applies to the later step that writes the answer (it took ~48 s to its first token at the provider default); "default" = the provider's own choice.
MAIN_THINKING=low
MAIN_THINKING_ANSWER=low

# ── Web search (at least one required; Exa is primary, Tavily is fallback) ──
# https://dashboard.exa.ai
EXA_API_KEY=
# https://app.tavily.com
TAVILY_API_KEY=

# ── App ───────────────────────────────────────────────────────────
PORT=8787
DB_PATH=./data/agent.db
# Max model steps per turn (each step = one model call)
MAX_STEPS=4

# ── Dev / eval only ───────────────────────────────────────────────
# Freeze "now" (ISO with offset), e.g. 2026-11-12T11:00:00+05:30. Leave empty for real time.
NOW=
# Cache LLM responses on disk to save free-tier quota while developing (1 = on)
DEV_LLM_CACHE=0
