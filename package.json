{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Chat agent with web search, dated memory and an answer ledger",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/check-env.mjs",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "chat": "tsx scripts/chat-cli.ts",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/react": "^4.0.170",
    "@hono/node-server": "^2.1.6",
    "ai": "^7.0.166",
    "better-sqlite3": "~12.9.0",
    "chrono-node": "^2.10.3",
    "dotenv": "^18.0.10",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
