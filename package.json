{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Chat agent with web search, dated memory and an answer ledger",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "predev": "node scripts/check-env.mjs",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "chat": "tsx scripts/chat-cli.ts",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {},
  "devDependencies": {}
}
